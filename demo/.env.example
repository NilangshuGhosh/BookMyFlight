# Copy this file to .env.local (in the demo/ folder) or set these as OS environment variables in production.

DB_URL=jdbc:postgresql://localhost:5432/bookmyflight
DB_USERNAME=postgres
DB_PASSWORD=your-db-password

# At least 32 characters (256 bits) for HS256 JWT signing
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

ADMIN_EMAIL=admin@bookmyflight.com
ADMIN_PASSWORD=replace-with-strong-admin-password

MAIL_USERNAME=your.email@gmail.com
MAIL_PASSWORD=your-google-app-password

# Comma-separated allowed frontend origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com
